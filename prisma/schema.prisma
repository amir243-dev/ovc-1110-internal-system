generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Expense {
  id         Int      @id @default(autoincrement())
  date       DateTime @default(now())
  item       String
  amount     Float
  approvedBy String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
